include(FetchContent)
# Shared source builds for macOS distribution and iPadOS; no Homebrew dylibs.
set(BUILD_SHARED_LIBS OFF CACHE BOOL "Static app dependencies" FORCE)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
set(SDL_HIDAPI OFF CACHE BOOL "" FORCE)
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(JSON_Install OFF CACHE BOOL "" FORCE)
set(SDL2IMAGE_SAMPLES OFF CACHE BOOL "" FORCE)
set(SDL2IMAGE_INSTALL OFF CACHE BOOL "" FORCE)
set(SDL2IMAGE_BACKEND_IMAGEIO ON CACHE BOOL "" FORCE)
foreach(format AVIF JXL TIF WEBP)
  set(SDL2IMAGE_${format} OFF CACHE BOOL "" FORCE)
endforeach()
set(SDL2TTF_SAMPLES OFF CACHE BOOL "" FORCE)
set(SDL2TTF_INSTALL OFF CACHE BOOL "" FORCE)
set(SDL2TTF_VENDORED OFF CACHE BOOL "" FORCE)
set(SDL2TTF_HARFBUZZ OFF CACHE BOOL "" FORCE)
foreach(feature ZLIB BZIP2 PNG BROTLI HARFBUZZ)
  set(FT_DISABLE_${feature} ON CACHE BOOL "" FORCE)
endforeach()
set(h3_archive_h3_sdl "${CMAKE_SOURCE_DIR}/build/vendor-downloads/SDL2-2.32.8.tar.gz")
if(EXISTS "${h3_archive_h3_sdl}")
  set(h3_url_h3_sdl "${h3_archive_h3_sdl}")
else()
  set(h3_url_h3_sdl "https://codeload.github.com/libsdl-org/SDL/tar.gz/refs/tags/release-2.32.8")
endif()
FetchContent_Declare(h3_sdl URL "${h3_url_h3_sdl}" URL_HASH SHA256=dd35e05644ae527848d02433bec24dd0ea65db59faecf1a0e5d1880c533dac2c DOWNLOAD_EXTRACT_TIMESTAMP TRUE)

set(h3_archive_h3_image "${CMAKE_SOURCE_DIR}/build/vendor-downloads/SDL2_image-2.8.8.tar.gz")
if(EXISTS "${h3_archive_h3_image}")
  set(h3_url_h3_image "${h3_archive_h3_image}")
else()
  set(h3_url_h3_image "https://codeload.github.com/libsdl-org/SDL_image/tar.gz/refs/tags/release-2.8.8")
endif()
FetchContent_Declare(h3_image URL "${h3_url_h3_image}" URL_HASH SHA256=2bd2c17cab3744ebfe7351ded8c70dc2078d8c7c24eb9f4ebb1b26a623e2a747 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)

set(h3_archive_h3_ttf "${CMAKE_SOURCE_DIR}/build/vendor-downloads/SDL2_ttf-2.24.0.tar.gz")
if(EXISTS "${h3_archive_h3_ttf}")
  set(h3_url_h3_ttf "${h3_archive_h3_ttf}")
else()
  set(h3_url_h3_ttf "https://codeload.github.com/libsdl-org/SDL_ttf/tar.gz/refs/tags/release-2.24.0")
endif()
FetchContent_Declare(h3_ttf URL "${h3_url_h3_ttf}" URL_HASH SHA256=2c45241a56203a59d66ec6b4eae9457e5675fc609376566a257391fd29d341a2 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)

set(h3_archive_h3_freetype "${CMAKE_SOURCE_DIR}/build/vendor-downloads/freetype-2.13.3.tar.gz")
if(EXISTS "${h3_archive_h3_freetype}")
  set(h3_url_h3_freetype "${h3_archive_h3_freetype}")
else()
  set(h3_url_h3_freetype "https://codeload.github.com/freetype/freetype/tar.gz/refs/tags/VER-2-13-3")
endif()
FetchContent_Declare(h3_freetype URL "${h3_url_h3_freetype}" URL_HASH SHA256=bc5c898e4756d373e0d991bab053036c5eb2aa7c0d5c67e8662ddc6da40c4103 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)

set(h3_archive_h3_json "${CMAKE_SOURCE_DIR}/build/vendor-downloads/json-3.11.3.tar.gz")
if(EXISTS "${h3_archive_h3_json}")
  set(h3_url_h3_json "${h3_archive_h3_json}")
else()
  set(h3_url_h3_json "https://codeload.github.com/nlohmann/json/tar.gz/refs/tags/v3.11.3")
endif()
FetchContent_Declare(h3_json URL "${h3_url_h3_json}" URL_HASH SHA256=0d8ef5af7f9794e3263480193c491549b2ba6cc74bb018906202ada498a79406 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(h3_json h3_sdl h3_freetype)
# SDL_ttf's find_package(Freetype) must resolve the target built for this
# platform, never a host Mac installation while cross-compiling for iPadOS.
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/h3-freetype-config")
file(WRITE "${CMAKE_BINARY_DIR}/h3-freetype-config/FreetypeConfig.cmake"
  "if(NOT TARGET Freetype::Freetype)\n  add_library(Freetype::Freetype ALIAS freetype)\nendif()\nset(Freetype_FOUND TRUE)\n")
set(Freetype_DIR "${CMAKE_BINARY_DIR}/h3-freetype-config" CACHE PATH "" FORCE)
set(CMAKE_FIND_PACKAGE_PREFER_CONFIG ON)
FetchContent_MakeAvailable(h3_image h3_ttf)
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
  # SDL_image 2.8's ImageIO backend omits these iOS frameworks from its
  # CMake link interface. Static consumers need both image decoding and UTIs.
  target_link_libraries(SDL2_image PRIVATE "-framework ImageIO" "-framework MobileCoreServices")
endif()
if(NOT TARGET SDL2_image::SDL2_image)
  add_library(SDL2_image::SDL2_image ALIAS SDL2_image)
endif()
if(NOT TARGET SDL2_ttf::SDL2_ttf)
  add_library(SDL2_ttf::SDL2_ttf ALIAS SDL2_ttf)
endif()
